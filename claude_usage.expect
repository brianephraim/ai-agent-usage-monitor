#!/usr/bin/expect -f
set timeout 15
log_user 1

# Make terminal behavior more predictable for TUIs
set env(TERM) "xterm-256color"

# Remove parent-session env vars so claude uses the locally-stored auth
# (the one from `claude auth login` in a standalone terminal)
foreach var {ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_BASE_URL CLAUDECODE CLAUDE_AGENT_SDK_VERSION CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_ENABLE_ASK_USER_QUESTION_TOOL CLAUDE_CODE_EMIT_TOOL_USE_SUMMARIES} {
  catch {unset env($var)}
}

proc force_shutdown {pid} {
  # Try all common shutdown paths on macOS/Linux.
  catch { exec pkill -TERM -P $pid }
  catch { exec kill -TERM $pid }
  catch { exec kill -TERM -$pid }
  after 300
  catch { exec pkill -KILL -P $pid }
  catch { exec kill -KILL $pid }
  catch { exec kill -KILL -$pid }
}

spawn sh -lc "exec claude"
set pid [exp_pid]

# --- Phase 1: Wait until Claude prints something we recognize ---
expect {
  -re {Claude Code} {}
  -re {Welcome back} {}
  -re {❯\s} {}
  -re {\?\s+for\s+shortcuts} {}
  timeout {
    puts "\n[clock format [clock seconds]] Timed out waiting for Claude UI to appear."
    force_shutdown $pid
    exit 1
  }
}

# --- Phase 2: Open /usage ---
send "/usage"
# Wait for autocomplete to appear before Enter (timing varies by terminal).
# Some terminals show autocomplete slowly; sending Enter too soon does nothing.
# Match flexibly since ANSI codes can appear between words.
set timeout 8
expect {
  -re {Show.*plan|plan.*usage|usage.*limits} {
    after 250
    send "\r"
  }
  timeout {
    # No autocomplete seen; send Enter anyway (minimal UI or fast env)
    after 200
    send "\r"
  }
}
set timeout 15
after 250
send "\r"

# Wait until usage sections show up. Allow extra time for "Loading usage data…".
# Match multiple patterns since ANSI escape codes can break "Current session".
set timeout 25
expect {
  -re {Current session} {}
  -re {Current week} {}
  -re {[0-9]+%\s*used} {}
  -re {\$[0-9]+\.[0-9]{2}.*spent} {}
  timeout {
    puts "\n[clock format [clock seconds]] Timed out waiting for usage screen."
    force_shutdown $pid
    exit 2
  }
}
set timeout 15

# Allow trailing lines (e.g., week/extra usage and resets) to flush.
after 450

# --- Phase 3: Fast shutdown ---
# We only need the rendered usage text, so avoid long graceful-exit waits.
force_shutdown $pid
set timeout 2
expect {
  eof {}
  timeout {}
}

# Clean up expect bookkeeping
catch { close }
catch { wait -i $spawn_id }

exit 0
